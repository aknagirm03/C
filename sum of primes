#include <stdio.h>

int isPrime(int n)
{
    if (n<2)
    {
        return 0;
    }
    
    for (int i=2; i<n; i++)
    {
        if (n%i==0)
        {
            return 0;
        }
    } return 1;
}


int sumOfPrimes(int start, int end)
{
    int sum=0;
    for (int i=start; i<=end; i++)
    {
        if (isPrime(i)==1)
        {
            sum+=i;
        }
    }
    return sum;
}

int main() {
    
    int input, inp;
    scanf("%d\n%d", &input, &inp);
    if ((input>=0)&&(inp>=0)&&(input<inp))
    {
    int sof = sumOfPrimes(input, inp);
        printf("%d", sof);
    } else {printf("Invalid input");}
    
    return 0;
}