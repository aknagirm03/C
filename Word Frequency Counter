#include <stdio.h>
#include <string.h>

//Write your extractWord function here
int extractWord(char *sentence, int startIndex, char *word)
{
    int extractIndex;
    for(int i=startIndex; i<=strlen(sentence); i++)
    {
        *word = sentence[i];
        if((sentence[i]==' ')||(sentence[i]=='\0'))
        {
            extractIndex = i;
            *word = '\0';
            return extractIndex;
        }
        word++;
    }
    
}

//Write your countWordOccurrences function here
int countWordOccurrences(char *sentence, char *targetWord)
{
    int sentLen = strlen(sentence);
    char word[sentLen];
    int times = 0;
    
    for(int i=0; i<sentLen; i++)
    {
        int EI = extractWord(sentence, i, word);
        int compare = strcmp(word, targetWord);
        if(compare==0)
        {
            times++;
        }
        i = EI;
    }
    return times;
}

//Write your analyzeText function here
int analyzeText(char *sentence)
{
    int noOfwords = 1;
    for(int i=0; i<strlen(sentence); i++)
    {
        if(sentence[i]==' ')
        {
            noOfwords++;
            
            if(sentence[i-1]==sentence[i])
            {
                noOfwords--;
            }
        }
    }
    return noOfwords;
}

int main() {
    char inputSentence[200];
    char searchWord[50];
    
    // Read input sentence
    fgets(inputSentence, sizeof(inputSentence), stdin);
    
    // Remove newline character if present
    inputSentence[strcspn(inputSentence, "\n")] = '\0';
    
    // Read search word
    scanf("%s", searchWord);
    
    // Call analyzeText function and store total word count
    int totalWords = analyzeText(inputSentence);
    printf("Total words: %d\n", totalWords);
    
    // Call countWordOccurrences function and store occurrences
    int occurrences = countWordOccurrences(inputSentence, searchWord);
    printf("Occurrences of '%s': %d\n", searchWord, occurrences);
    
    // Calculate frequency percentage
    float frequency = ((float)occurrences/(float)totalWords)*100;
    printf("Frequency: %.1f%%\n", frequency);
    
